# Copiare in .env e valorizzare prima di "docker compose up"

# Postgres (unica istanza, due database logici: airflow_meta e warehouse)
POSTGRES_USER=istat
POSTGRES_PASSWORD=changeme
POSTGRES_DB=airflow_meta
WAREHOUSE_DB=warehouse

# Airflow
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__WEBSERVER__SECRET_KEY=changeme
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# Connessione al warehouse usata da src/ e dashboard/
WAREHOUSE_HOST=postgres
WAREHOUSE_PORT=5432
